# .npmrc
# 解决 pnpm 11 的 onlyBuiltDependencies 配置
# pnpm 11 不再从 package.json 读取 pnpm.onlyBuiltDependencies
# 改为从 .npmrc 或 pnpm-workspace.yaml 读取

# 指定需要强制构建的依赖包
only-built-dependencies[]=electron
only-built-dependencies[]=esbuild
only-built-dependencies[]=electron-winstaller

# 其他推荐配置
auto-install-peers=true
strict-peer-dependencies=false
node-linker=hoisted

block-exotic-subdeps=false